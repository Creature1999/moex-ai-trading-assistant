# Тикеры MOEX через запятую
TICKERS=SBER,GAZP,LKOH,ROSN,YDEX
MOEX_BOARD=TQBR

# 0 = автоматическое сканирование выключено.
# Для регулярного сканирования задайте, например, 60.
SCAN_INTERVAL_MINUTES=0

# RSS URL через запятую. Оставьте пустым, пока не выбраны проверенные источники.
RSS_FEEDS=

# Создайте бота через @BotFather; секреты задаются в переменных окружения хостинга.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# На Render persistent disk:
DB_PATH=/var/data/assistant.db
